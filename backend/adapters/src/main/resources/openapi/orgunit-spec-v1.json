{
  "openapi": "3.0.1",
  "info": {
    "title": "OrgUnit Api",
    "description": "### Id for Example OrgUnit:\n\n> ***OrgUnit:*** AAUORG1234",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "https://cris-staging.aau.at/ris-synergy/orgUnit"
    }
  ],
  "tags": [
    {
      "name": "OrgUnits",
      "description": "Endpoints for Organizational Units"
    }
  ],
  "paths": {
    "/v1/orgUnits/{id}": {
      "get": {
        "tags": [
          "OrgUnits"
        ],
        "summary": "GET Endpoint for OrgUnit",
        "description": "Get Endpoint for retrieving OrgUnit via ID",
        "operationId": "findByKey",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnit"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orgUnits/organigram": {
      "get": {
        "tags": [
          "OrgUnits"
        ],
        "summary": "GET Endpoint for the Organigram",
        "description": "Get Endpoint for retrieving an organizational tree of an University",
        "operationId": "findAll",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnit"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Identifier": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/IdentifierTypeEnum"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "IdentifierTypeEnum": {
        "type": "string",
        "description": "[Vocabulary](https://documentation.forschungsdaten.at/?page_id=937)",
        "enum": [
          "CROSSREF_GRANTID",
          "PROJECT_NUMBER",
          "APPLICATION_NUMBER",
          "ORCID",
          "ROR",
          "RINGGOLD",
          "RIS_SYNERGY"
        ]
      },
      "LevelEnum": {
        "type": "string",
        "description": "[Vocabulary](https://documentation.forschungsdaten.at/?page_id=902)",
        "enum": [
          "LEVEL_1",
          "LEVEL_2",
          "Level_3"
        ]
      },
      "OrgUnit": {
        "required": [
          "endDate",
          "id",
          "level",
          "name",
          "startDate",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Text"
            }
          },
          "type": {
            "$ref": "#/components/schemas/OrganisationTypeEnum"
          },
          "acronym": {
            "type": "string"
          },
          "electronicAddress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "partOf": {
            "$ref": "#/components/schemas/OrgUnit"
          },
          "identifiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          "address": {
            "$ref": "#/components/schemas/PostAddress"
          },
          "submissionSystem": {
            "type": "string"
          },
          "level": {
            "$ref": "#/components/schemas/LevelEnum"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "website": {
            "type": "string"
          }
        }
      },
      "OrganisationTypeEnum": {
        "type": "string",
        "description": "[Vocabulary](https://documentation.forschungsdaten.at/?page_id=898)",
        "enum": [
          "UNIVERSITY",
          "VICE_RECTORATE",
          "FACULTY",
          "SCHOOL",
          "DEPARTMENT",
          "UNIT",
          "CENTRAL_SERVICES",
          "UNIVERSITY_CENTRE",
          "CLINIC",
          "CLINICAL_UNIT"
        ]
      },
      "PostAddress": {
        "type": "object",
        "properties": {
          "countryCode": {
            "type": "string"
          },
          "addrline1": {
            "type": "string"
          },
          "postCode": {
            "type": "string"
          },
          "cityTown": {
            "type": "string"
          },
          "stateOfCountry": {
            "type": "string"
          }
        }
      },
      "Text": {
        "type": "object",
        "properties": {
          "lang": {
            "type": "string"
          },
          "trans": {
            "type": "string",
            "enum": [
              "O",
              "H",
              "M"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}