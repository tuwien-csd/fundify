{
  "name": "fundify-fe",
  "version": "0.1.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "openapi:generate:from-local-be": "openapi-typescript http://localhost:8080/api/openapi -o src/generated/refop-be.ts",
    "test": "ng test",
    "test:e2e": "npx playwright test",
    "test:e2e-ui": "npx playwright test --ui",
    "test:e2e-generate": "npx playwright codegen localhost:4200/ --viewport-size='1920,1080' --load-storage='e2e/config/.auth/funder.json'",
    "test:e2e-generate-login": "npx playwright codegen localhost:4200/ --save-storage='e2e/config/.auth/admin.json'",
    "ci:test": "ng test --watch=false --browsers=ChromeHeadless",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "engines": {
    "node": "22.18"
  },
  "dependencies": {
    "@angular/animations": "20.1.4",
    "@angular/cdk": "20.1.4",
    "@angular/common": "20.1.4",
    "@angular/compiler": "20.1.4",
    "@angular/core": "20.1.4",
    "@angular/forms": "20.1.4",
    "@angular/material": "20.1.4",
    "@angular/platform-browser": "20.1.4",
    "@angular/platform-browser-dynamic": "20.1.4",
    "@angular/router": "20.1.4",
    "@ngrx/effects": "20.0.0",
    "@ngrx/entity": "20.0.0",
    "@ngrx/operators": "^20.0.0",
    "@ngrx/router-store": "20.0.0",
    "@ngrx/signals": "20.0.0",
    "@ngrx/store": "20.0.0",
    "@ngrx/store-devtools": "20.0.0",
    "@tailwindcss/postcss": "4.1.11",
    "angular-oauth2-oidc": "20.0.2",
    "openapi-fetch": "0.14.0",
    "postcss": "8.5.6",
    "rxjs": "~6.6.7",
    "tailwindcss": "4.1.11",
    "tslib": "^2.3.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.1.4",
    "@angular-devkit/core": "20.1.4",
    "@angular-devkit/schematics": "20.1.4",
    "@angular-eslint/builder": "20.1.1",
    "@angular-eslint/eslint-plugin": "20.1.1",
    "@angular-eslint/eslint-plugin-template": "20.1.1",
    "@angular-eslint/schematics": "20.1.1",
    "@angular-eslint/template-parser": "20.1.1",
    "@angular/build": "^20.1.4",
    "@angular/cli": "20.1.4",
    "@angular/compiler-cli": "20.1.4",
    "@playwright/test": "1.54.2",
    "@schematics/angular": "20.1.4",
    "@types/jasmine": "~3.10.0",
    "@types/node": "18.19.9",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "angular-eslint": "20.1.1",
    "dotenv": "17.2.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-interactive": "12.0.0",
    "eslint-plugin-prettier": "5.5.4",
    "husky": "9.1.7",
    "jasmine-core": "~3.10.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.1",
    "karma-jasmine-html-reporter": "~1.7.0",
    "ngxtension": "^4.0.0",
    "openapi-typescript": "7.8.0",
    "playwright-ng-schematics": "2.1.0",
    "prettier": "3.6.2",
    "prettier-eslint": "16.4.2",
    "typescript": "5.8.3"
  }
